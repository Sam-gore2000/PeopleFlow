PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hrms
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

APP_TIMEZONE=Asia/Kolkata

# Attendance calendar
# Weekly offs: 0=Sun 1=Mon ... 6=Sat (e.g. "0" for Sunday only)
WEEKLY_OFF_DAYS=0,6
# Paid leave earned every month from the joining date
LEAVE_ACCRUAL_PER_MONTH=1.5
# Forgot password emails (Gmail): the Gmail address and its App Password (never commit real values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="LionReach HRMS <your-address@gmail.com>"
# Paid leave can be used only after this many months from the joining date
PROBATION_MONTHS=3
# Leave year start month (1 = Jan-Dec, 4 = Apr-Mar). Balances start fresh each leave year.
LEAVE_YEAR_START_MONTH=1
