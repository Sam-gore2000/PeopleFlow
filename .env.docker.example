# ============================================================
# HRMS production settings. Copy to .env and fill in:
#     cp .env.docker.example .env
# Never commit .env to Git.
# ============================================================

# ---- Website address ----
# Your domain (its DNS "A" record must point to this server's IP). HTTPS is set up automatically.
SITE_ADDRESS=hrm.example.com
PUBLIC_URL=https://hrm.example.com
COOKIE_SECURE=true
# Testing by IP without a domain? Use instead:
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://YOUR.SERVER.IP
#   COOKIE_SECURE=false

# ---- Database (letters and numbers only for the password) ----
MONGO_ROOT_USER=hrms
MONGO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ---- Login security: a long random value (openssl rand -hex 48) ----
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48

# ---- Email for forgot-password codes (Gmail + App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="LionReach HRMS <your-gmail@gmail.com>"

# ---- Company rules ----
APP_TIMEZONE=Asia/Kolkata
WEEKLY_OFF_DAYS=0,6
LEAVE_ACCRUAL_PER_MONTH=1.5
LEAVE_YEAR_START_MONTH=1
PROBATION_MONTHS=3
